# FastAPI metadata và route
APP_NAME=Garbage Detection API
APP_VERSION=1.0.0
API_PREFIX=/api/v1
HEALTH_ROUTE=/health
RUNTIME_CONFIG_ROUTE=/config
PREDICT_ROUTE=/predict
DOCS_URL=/docs
OPENAPI_URL=/openapi.json

# Model và inference
MODEL_PATH=weights/best.pt
CLASS_MAPPING_PATH=backend/config/class_mapping.json
MODEL_DEVICE=
IMAGE_SIZE=640
MIN_CONFIDENCE=0.01
MAX_CONFIDENCE=1.0
DEFAULT_CONFIDENCE=0.30
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
INFERENCE_TIME_DECIMALS=2
ALLOWED_IMAGE_TYPES_CSV=image/jpeg,image/png,image/webp

# CORS
CORS_ORIGINS_CSV=http://localhost:8443,http://127.0.0.1:8443
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS_CSV=GET,POST
CORS_ALLOW_HEADERS_CSV=Content-Type

# Uvicorn
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=true
SERVER_WORKERS=1

# Chỉ các biến có prefix VITE_ mới được Vite đưa vào frontend bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_RUNTIME_CONFIG_PATH=/api/v1/config
